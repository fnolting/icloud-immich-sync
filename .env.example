# iCloud Shared Album
# Token from the public/shared iCloud album URL
ICLOUD_SHARED_ALBUM_TOKEN=

# Immich
IMMICH_URL=
IMMICH_API_KEY=

# Target Immich album
IMMICH_ALBUM_NAME=My Shared Album

# Optional: synchronization interval in seconds
# Default: 1800 (30 minutes)
# SYNC_INTERVAL=1800

# Optional: SQLite state database
# Default: /data/state.db
# STATE_DB=/data/state.db

# Optional: temporary download directory
# Default: /tmp/icloud
# TMP_DIR=/tmp/icloud

# Optional: logging level
# Default: INFO
# LOG_LEVEL=INFO

# Optional: dry-run mode
# Default: true
# DRY_RUN=true

# Optional: HTTP request timeout in seconds
# Default: 60
# REQUEST_TIMEOUT=60

# Optional: iCloud Shared Streams API host
# Normally discovered automatically.
# ICLOUD_SHAREDSTREAMS_HOST=p23-sharedstreams.icloud.com
